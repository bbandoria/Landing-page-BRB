---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "BRB Agência Digital — Tráfego Pago, Trackeamento e CRM para Vender Mais",
  description = "Agência especializada em Ecommerce e Negócio Local. Mais de R$6 milhões investidos em anúncios, trackeamento avançado e CRM próprio. Fale com a gente.",
} = Astro.props;

// TODO: defina `site` em astro.config.mjs quando o domínio final for escolhido
// para que og:image e og:url virem URLs absolutas (exigido por WhatsApp/Instagram/etc).
const ogImage = new URL("/og-image.png", Astro.site ?? Astro.url.origin).toString();
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#1b2e6e" />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
