---
interface Props {
  variant?: "light" | "dark";
  class?: string;
}

const { variant = "light", class: className = "" } = Astro.props;
---

<span class={`logo logo--${variant} ${className}`}>
  <span class="logo__mark">BRB</span>
  <span class="logo__sub">Agência Digital</span>
</span>

<style>
  .logo {
    display: inline-flex;
    flex-direction: column;
    line-height: 1;
    gap: 0.2rem;
  }

  .logo__mark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: -0.02em;
  }

  .logo--light .logo__mark {
    color: var(--white);
  }

  .logo--dark .logo__mark {
    background: var(--brand-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .logo__sub {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.6rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .logo--light .logo__sub {
    color: rgba(255, 255, 255, 0.75);
  }

  .logo--dark .logo__sub {
    color: var(--gray);
  }
</style>
