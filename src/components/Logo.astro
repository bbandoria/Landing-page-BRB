---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

interface Props {
  size?: "sm" | "md";
  class?: string;
}

const { size = "md", class: className = "" } = Astro.props;
---

<span class={`logo logo--${size} ${className}`}>
  <Image src={logo} alt="BRB Agência Digital" width={280} height={280} />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.96);
    border-radius: 10px;
    padding: 0.4rem 0.7rem;
    line-height: 0;
  }

  .logo :global(img) {
    height: 1.9rem;
    width: auto;
  }

  .logo--sm :global(img) {
    height: 1.5rem;
  }
</style>
