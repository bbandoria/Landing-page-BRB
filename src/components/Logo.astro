---
import { Image } from "astro:assets";
import logoOnLight from "../assets/logo-onlight.png";
import logoOnDark from "../assets/logo-ondark.png";

interface Props {
  size?: "sm" | "md" | "lg";
  /** "onlight" = subtítulo escuro, para fundo claro. "ondark" = subtítulo branco, para fundo escuro. */
  tone?: "onlight" | "ondark";
  class?: string;
}

const { size = "md", tone = "ondark", class: className = "" } = Astro.props;
const logo = tone === "onlight" ? logoOnLight : logoOnDark;
---

<span class={`logo logo--${size} ${className}`}>
  <Image src={logo} alt="BRB Agência Digital" width={1024} height={1024} />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    aspect-ratio: 2.35 / 1;
    height: 2.5rem;
  }

  .logo :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center 49%;
  }

  .logo--sm {
    height: 1.9rem;
  }

  .logo--lg {
    height: 3.9rem;
  }
</style>
