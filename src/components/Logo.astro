---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

interface Props {
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { size = "md", class: className = "" } = Astro.props;
---

<span class={`logo logo--${size} ${className}`}>
  <Image src={logo} alt="BRB Agência Digital" width={1024} height={1024} />
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    overflow: hidden;
    aspect-ratio: 2.35 / 1;
    height: 2.5rem;
  }

  .logo :global(img) {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center 49%;
    /* Soft white halo so the logo reads on dark brand backgrounds
       without a solid background chip (transparent PNG stays transparent). */
    filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.9)) drop-shadow(0 1px 10px rgba(255, 255, 255, 0.55));
  }

  .logo--sm {
    height: 1.9rem;
  }

  .logo--lg {
    height: 3.4rem;
  }
</style>
