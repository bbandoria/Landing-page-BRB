---
import { Image } from "astro:assets";
import crmScreenshot from "../assets/crm-screenshot.jpg";
---

<section class="section provasocial">
  <div class="container provasocial__inner">
    <p class="eyebrow" data-reveal>Resultado que fala por si</p>
    <p class="provasocial__body" data-reveal style="transition-delay: 60ms">
      <strong data-counter data-counter-to="6" data-counter-prefix="+R$" data-counter-suffix=" milhões">+R$6 milhões</strong> investidos em anúncios geridos pela nossa equipe,
      com foco em <strong>E-commerce</strong> e <strong>Negócio Local</strong>.
    </p>

    <figure class="provasocial__proof" data-reveal style="transition-delay: 120ms">
      <div class="provasocial__frame">
        <div class="provasocial__framebar">
          <span></span><span></span><span></span>
          <span class="provasocial__framebar-label">CRM BRB · funil de vendas real</span>
        </div>
        <Image src={crmScreenshot} alt="Painel do CRM próprio da BRB, com o funil de vendas real da agência" width={1200} loading="lazy" />
      </div>
      <figcaption>Nosso CRM, em uso real todos os dias. Dados de clientes borrados por privacidade.</figcaption>
    </figure>
  </div>
</section>

<style>
  .provasocial {
    background: var(--bg-raised);
    border-top: 1px solid rgba(11, 23, 48, 0.06);
    border-bottom: 1px solid rgba(11, 23, 48, 0.06);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .provasocial__inner {
    max-width: 860px;
  }

  .provasocial__body {
    margin-top: 0.75rem;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    color: var(--ink);
  }

  .provasocial__body strong {
    color: var(--blue);
  }

  .provasocial__proof {
    margin: 2.5rem 0 0;
  }

  .provasocial__frame {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 30px 60px -24px rgba(11, 23, 48, 0.35);
    border: 1px solid rgba(11, 23, 48, 0.08);
  }

  .provasocial__framebar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    background: var(--bg);
    border-bottom: 1px solid rgba(11, 23, 48, 0.08);
  }

  .provasocial__framebar span:not(.provasocial__framebar-label) {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: rgba(11, 23, 48, 0.15);
  }

  .provasocial__framebar-label {
    margin-left: 0.5rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--gray);
  }

  .provasocial__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .provasocial__proof figcaption {
    margin-top: 0.85rem;
    font-size: 0.85rem;
    color: var(--gray);
    text-align: center;
  }
</style>
