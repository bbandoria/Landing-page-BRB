<section class="section provasocial">
  <div class="container provasocial__inner">
    <p class="eyebrow" data-reveal>Resultado que fala por si</p>
    <p class="provasocial__body" data-reveal style="transition-delay: 60ms">
      <strong data-counter data-counter-to="6" data-counter-prefix="+R$" data-counter-suffix=" milhões">+R$6 milhões</strong> investidos em anúncios geridos pela nossa equipe,
      com foco em <strong>Ecommerce</strong> e <strong>Negócio Local</strong>.
    </p>
  </div>
</section>

<style>
  .provasocial {
    background: var(--bg-raised);
    border-top: 1px solid rgba(11, 23, 48, 0.06);
    border-bottom: 1px solid rgba(11, 23, 48, 0.06);
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .provasocial__inner {
    max-width: 720px;
  }

  .provasocial__body {
    margin-top: 0.75rem;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    color: var(--ink);
  }

  .provasocial__body strong {
    color: var(--blue);
  }
</style>
