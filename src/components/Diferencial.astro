---
import { icons } from "./icons";

const diferenciais = [
  {
    icon: "ads",
    stat: "+R$6 milhões",
    counterTo: 6,
    label: "investidos em anúncios geridos",
    body: "Experiência prática, não teoria.",
  },
  {
    icon: "tracking",
    stat: "Trackeamento próprio",
    counterTo: null,
    label: "estrutura de dados avançada",
    body: "Decisão baseada em dado confiável, não em achismo de dashboard genérico.",
  },
  {
    icon: "crm",
    stat: "CRM profissional",
    counterTo: null,
    label: "sistema próprio da BRB",
    body: "O lead entra pelo anúncio e sai fechado, sem perder no caminho.",
  },
] as const;
---

<section id="diferencial" class="section diferencial">
  <div class="diferencial__dots" aria-hidden="true"></div>
  <div class="diferencial__glow" aria-hidden="true"></div>
  <div class="container">
    <p class="eyebrow eyebrow--light" data-reveal>Por que a BRB</p>
    <h2 class="diferencial__title" data-reveal style="transition-delay: 60ms">
      A maioria das agências entrega apenas anúncios, nós entregamos a estrutura completa de marketing para sua empresa.
    </h2>

    <div class="diferencial__grid">
      {
        diferenciais.map((d, i) => (
          <div class="diferencial-item" data-reveal style={`transition-delay:${i * 80}ms`}>
            <span class="diferencial-item__icon" set:html={icons[d.icon]} />
            {d.counterTo ? (
              <strong class="diferencial-item__stat" data-counter data-counter-to={d.counterTo} data-counter-prefix="+R$" data-counter-suffix=" milhões">
                {d.stat}
              </strong>
            ) : (
              <strong class="diferencial-item__stat">{d.stat}</strong>
            )}
            <span class="diferencial-item__label">{d.label}</span>
            <p class="diferencial-item__body">{d.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .diferencial {
    position: relative;
    background: var(--ink);
    color: var(--white);
    overflow: hidden;
  }

  .diferencial__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.14) 1.5px, transparent 1.5px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse at 30% 30%, black 0%, transparent 70%);
    pointer-events: none;
  }

  .diferencial__glow {
    position: absolute;
    inset: 0;
    background: var(--brand-gradient-diagonal);
    opacity: 0.35;
    pointer-events: none;
  }

  .diferencial .container {
    position: relative;
  }

  .diferencial__title {
    margin-top: 0.75rem;
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
    max-width: min(52ch, 100%);
    color: var(--white);
  }

  .diferencial__grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .diferencial-item {
    display: flex;
    flex-direction: column;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.18);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .diferencial-item:hover {
    border-top-color: var(--gold);
    transform: translateY(-4px);
  }

  .diferencial-item__icon {
    width: 2.25rem;
    height: 2.25rem;
    color: var(--gold);
  }

  .diferencial-item__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .diferencial-item__stat {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
  }

  .diferencial-item__label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.65);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .diferencial-item__body {
    margin-top: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
  }
</style>
