---
const passos = [
  {
    n: "01",
    title: "Diagnóstico",
    body: "Analisamos seu momento atual: campanhas, site, funil de vendas e os dados que você já tem disponíveis.",
  },
  {
    n: "02",
    title: "Estratégia",
    body: "Montamos o plano de tráfego pago, trackeamento e CRM certo pro seu negócio, sem fórmula pronta.",
  },
  {
    n: "03",
    title: "Execução",
    body: "Colocamos tudo no ar: campanhas, integrações de trackeamento e automações do CRM rodando.",
  },
  {
    n: "04",
    title: "Relatório",
    body: "Você acompanha o resultado real, com dado, sem depender da nossa palavra pra saber se está funcionando.",
  },
] as const;
---

<section id="como-funciona" class="section como-funciona">
  <div class="container">
    <p class="eyebrow" data-reveal>Como funciona</p>
    <h2 class="como-funciona__title" data-reveal style="transition-delay: 60ms">Da dúvida ao resultado<br />em 4 passos</h2>

    <ol class="como-funciona__list">
      {
        passos.map((p, i) => (
          <li class="como-funciona__step" data-reveal style={`transition-delay:${i * 90}ms`}>
            <span class="como-funciona__number">{p.n}</span>
            <h3 class="como-funciona__step-title">{p.title}</h3>
            <p class="como-funciona__step-body">{p.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .como-funciona {
    background: var(--bg-raised);
  }

  .como-funciona__title {
    margin-top: 0.75rem;
    font-size: clamp(1.7rem, 3.6vw, 2.6rem);
  }

  .como-funciona__list {
    margin: 3rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .como-funciona__step {
    position: relative;
    padding-top: 1.5rem;
    border-top: 3px solid var(--blue);
  }

  .como-funciona__step:nth-child(2) {
    border-top-color: var(--cyan);
  }

  .como-funciona__step:nth-child(3) {
    border-top-color: var(--gold);
  }

  .como-funciona__step:nth-child(4) {
    border-top-color: var(--red);
  }

  .como-funciona__number {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.1rem;
    color: var(--gray);
  }

  .como-funciona__step-title {
    margin-top: 0.6rem;
    font-size: 1.2rem;
  }

  .como-funciona__step-body {
    margin-top: 0.6rem;
    color: var(--gray);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .como-funciona__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .como-funciona__list {
      grid-template-columns: 1fr;
    }
  }
</style>
