---
import { whatsappLink } from "../lib/contact";
import { icons } from "./icons";
---

<a
  class="floating-wpp"
  href={whatsappLink()}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Falar no WhatsApp com a BRB Agência Digital"
>
  <Fragment set:html={icons.whatsapp} />
</a>

<style>
  .floating-wpp {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 14px 28px -10px rgba(0, 0, 0, 0.45);
    transition: opacity 0.25s ease, transform 0.25s ease, box-shadow 0.2s ease;
  }

  :global(.js) .floating-wpp {
    opacity: 0;
    transform: translateY(12px) scale(0.9);
    pointer-events: none;
  }

  :global(.js) .floating-wpp.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .floating-wpp:hover {
    box-shadow: 0 18px 34px -8px rgba(0, 0, 0, 0.5);
    transform: translateY(-2px) scale(1.04);
  }

  .floating-wpp :global(svg) {
    width: 1.7rem;
    height: 1.7rem;
  }

  .floating-wpp::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #25d366;
    animation: floatPulse 2.6s ease-out infinite;
  }

  @keyframes floatPulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(1.5);
      opacity: 0;
    }
  }

  @media (max-width: 640px) {
    .floating-wpp {
      right: 1rem;
      bottom: 1rem;
      width: 3.1rem;
      height: 3.1rem;
    }
  }
</style>
