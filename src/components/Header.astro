---
import Logo from "./Logo.astro";
import { whatsappLink } from "../lib/contact";
---

<header class="header">
  <div class="container header__inner">
    <a href="#hero" class="header__logo" aria-label="BRB Agência Digital — voltar ao topo">
      <Logo size="lg" tone="onlight" />
    </a>

    <nav class="header__nav" aria-label="Navegação principal">
      <a href="#servicos">Serviços</a>
      <a href="#diferencial">Diferencial</a>
      <a href="#faq">Dúvidas</a>
    </nav>

    <a class="btn btn--primary header__cta" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
      Falar no WhatsApp
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg-raised);
    border-bottom: 1px solid rgba(11, 23, 48, 0.08);
    transition: box-shadow 0.3s ease;
  }

  .header.is-scrolled {
    box-shadow: 0 12px 30px -16px rgba(11, 23, 48, 0.25);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.85rem;
  }

  .header__nav {
    display: flex;
    gap: 2rem;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .header__nav a {
    color: var(--ink);
    opacity: 0.75;
    transition: opacity 0.15s ease;
  }

  .header__nav a:hover {
    opacity: 1;
  }

  .header__cta {
    padding: 0.65rem 1.25rem;
    font-size: 0.9rem;
  }

  @media (max-width: 760px) {
    .header__nav {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .header__inner {
      padding-block: 0.6rem;
    }

    .header__cta {
      padding: 0.55rem 0.9rem;
      font-size: 0.82rem;
    }
  }
</style>
