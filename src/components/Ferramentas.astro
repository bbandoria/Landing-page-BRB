---
import { icons } from "./icons";

const ferramentas = [
  { icon: "meta", label: "Meta Ads" },
  { icon: "ads", label: "Google Ads" },
  { icon: "tiktok", label: "TikTok Ads" },
  { icon: "whatsapp", label: "WhatsApp Business" },
  { icon: "chart", label: "Google Analytics 4" },
  { icon: "crm", label: "CRM BRB", brand: true },
] as const;
---

<section class="ferramentas">
  <div class="container">
    <p class="ferramentas__label" data-reveal>Operamos com as principais plataformas do mercado</p>

    <ul class="ferramentas__list">
      {
        ferramentas.map((f, i) => (
          <li data-reveal style={`transition-delay:${i * 60}ms`}>
            <span class={f.brand ? "ferramentas__pill ferramentas__pill--brand" : "ferramentas__pill"}>
              <span class="ferramentas__icon" set:html={icons[f.icon]} />
              {f.label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ferramentas {
    background: var(--bg-raised);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid rgba(11, 23, 48, 0.06);
  }

  .ferramentas__label {
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gray);
  }

  .ferramentas__list {
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .ferramentas__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem 0.55rem 0.7rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid rgba(11, 23, 48, 0.08);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .ferramentas__icon {
    display: inline-flex;
    width: 1.35rem;
    height: 1.35rem;
    color: var(--blue);
  }

  .ferramentas__icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .ferramentas__pill:hover {
    transform: translateY(-2px);
    border-color: var(--blue);
    box-shadow: 0 10px 22px -14px rgba(30, 95, 184, 0.5);
  }

  .ferramentas__pill--brand {
    background: var(--brand-gradient);
    color: var(--white);
    border-color: transparent;
  }

  .ferramentas__pill--brand .ferramentas__icon {
    color: var(--white);
  }
</style>
