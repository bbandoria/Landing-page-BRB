---
const ferramentas = [
  "Meta Ads",
  "Google Ads",
  "TikTok Ads",
  "WhatsApp Business",
  "Google Analytics 4",
  "CRM BRB",
] as const;

// Duplicated once so the marquee track can loop seamlessly at -50%.
const track = [...ferramentas, ...ferramentas];
---

<section class="ferramentas">
  <div class="container">
    <p class="ferramentas__label" data-reveal>Operamos com as principais plataformas do mercado</p>
  </div>

  <div class="ferramentas__viewport" data-reveal style="transition-delay: 60ms">
    <ul class="ferramentas__track">
      {
        track.map((f) => (
          <li>
            <span class={f === "CRM BRB" ? "ferramentas__pill ferramentas__pill--brand" : "ferramentas__pill"}>{f}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ferramentas {
    background: var(--bg-raised);
    padding-block: clamp(2.5rem, 5vw, 3.5rem);
    border-bottom: 1px solid rgba(11, 23, 48, 0.06);
  }

  .ferramentas__label {
    text-align: center;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gray);
  }

  .ferramentas__viewport {
    margin-top: 1.5rem;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .ferramentas__track {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    width: max-content;
    gap: 0.75rem;
    animation: marquee 22s linear infinite;
  }

  .ferramentas__viewport:hover .ferramentas__track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .ferramentas__pill {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    background: var(--bg);
    border: 1px solid rgba(11, 23, 48, 0.08);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ink);
    white-space: nowrap;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }

  .ferramentas__pill:hover {
    transform: translateY(-2px);
    border-color: var(--blue);
  }

  .ferramentas__pill--brand {
    background: var(--brand-gradient);
    color: var(--white);
    border-color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .ferramentas__viewport {
      overflow: visible;
      mask-image: none;
      -webkit-mask-image: none;
    }

    .ferramentas__track {
      animation: none;
      flex-wrap: wrap;
      justify-content: center;
    }

    .ferramentas__track li:nth-child(n + 7) {
      display: none;
    }
  }
</style>
