---
import { whatsappLink } from "../lib/contact";
import { icons } from "./icons";
---

<section id="hero" class="hero">
  <div class="hero__glow hero__glow--a" aria-hidden="true"></div>
  <div class="hero__glow hero__glow--b" aria-hidden="true"></div>
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow eyebrow--light" data-reveal>Tráfego pago · Trackeamento · CRM</p>

      <h1 class="hero__headline" data-reveal style="transition-delay: 60ms">
        Você continua fazendo as mesmas coisas <span class="hero__headline-accent">e esperando resultados diferentes?</span>
      </h1>

      <p class="hero__sub" data-reveal style="transition-delay: 120ms">
        A BRB junta tráfego pago, trackeamento avançado e CRM próprio num só lugar —
        pra sua empresa vender mais com dado real, não achismo.
      </p>

      <div class="hero__actions" data-reveal style="transition-delay: 180ms">
        <a class="btn btn--primary hero__cta" href={whatsappLink()} target="_blank" rel="noopener noreferrer">
          <Fragment set:html={icons.whatsapp} />
          Falar com um especialista agora
        </a>
        <div class="hero__proof">
          <strong data-counter data-counter-to="6" data-counter-prefix="+R$" data-counter-suffix=" milhões">+R$6 milhões</strong>
          <span>investidos em anúncios geridos</span>
        </div>
      </div>
    </div>

    <div class="hero__visual" data-reveal style="transition-delay: 160ms">
      <div class="mockup">
        <div class="mockup__topbar">
          <span></span><span></span><span></span>
          <span class="mockup__topbar-label">Painel BRB · tempo real</span>
        </div>

        <div class="mockup__stats">
          <div class="mockup__stat">
            <span class="mockup__stat-label">ROAS médio</span>
            <strong class="mockup__stat-value" data-counter data-counter-to="5.8" data-counter-decimals="1" data-counter-suffix="x">5.8x</strong>
          </div>
          <div class="mockup__stat">
            <span class="mockup__stat-label">Leads hoje</span>
            <strong class="mockup__stat-value" data-counter data-counter-to="47">47</strong>
          </div>
        </div>

        <div class="mockup__chart" aria-hidden="true">
          <span style="--h:38%; --d:0ms"></span>
          <span style="--h:52%; --d:60ms"></span>
          <span style="--h:46%; --d:120ms"></span>
          <span style="--h:70%; --d:180ms"></span>
          <span style="--h:58%; --d:240ms"></span>
          <span style="--h:88%; --d:300ms"></span>
          <span style="--h:74%; --d:360ms"></span>
        </div>

        <ul class="mockup__feed">
          <li><span class="mockup__dot mockup__dot--live"></span> Novo lead qualificado <em>agora</em></li>
          <li><span class="mockup__dot mockup__dot--gold"></span> Campanha otimizada <em>2 min</em></li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--brand-gradient-diagonal);
    background-size: 220% 220%;
    animation: heroGradient 16s ease-in-out infinite alternate;
    color: var(--white);
    overflow: hidden;
    padding-block: clamp(4.5rem, 12vw, 7rem) clamp(4rem, 10vw, 6rem);
  }

  @keyframes heroGradient {
    0% {
      background-position: 10% 20%;
    }
    100% {
      background-position: 90% 80%;
    }
  }

  .hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
  }

  .hero__glow--a {
    top: -15%;
    left: -8%;
    width: 46%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(43, 184, 217, 0.5), transparent);
    animation: driftA 11s ease-in-out infinite alternate;
  }

  .hero__glow--b {
    bottom: -25%;
    right: -10%;
    width: 40%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgba(232, 163, 61, 0.35), transparent);
    animation: driftB 13s ease-in-out infinite alternate;
  }

  @keyframes driftA {
    to {
      transform: translate(6%, 8%);
    }
  }

  @keyframes driftB {
    to {
      transform: translate(-7%, -6%);
    }
  }

  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .eyebrow--light {
    color: rgba(255, 255, 255, 0.8);
  }

  .hero__headline {
    margin-top: 1rem;
    font-size: clamp(2.1rem, 4.4vw, 3.6rem);
    color: var(--white);
  }

  .hero__headline-accent {
    background: linear-gradient(100deg, #fff 0%, var(--gold) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero__sub {
    margin-top: 1.5rem;
    max-width: 46ch;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: rgba(255, 255, 255, 0.88);
  }

  .hero__actions {
    margin-top: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .hero__cta {
    position: relative;
  }

  .hero__cta :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .hero__cta::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 999px;
    border: 2px solid var(--gold);
    opacity: 0;
    animation: ctaPulse 2.6s ease-out infinite;
    pointer-events: none;
  }

  @keyframes ctaPulse {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  .hero__proof {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .hero__proof strong {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.15rem;
  }

  .hero__proof span {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
  }

  /* Mockup */
  .hero__visual {
    perspective: 1400px;
  }

  .mockup {
    background: var(--white);
    color: var(--ink);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: 0 40px 70px -20px rgba(4, 12, 34, 0.55);
    transform: rotateY(-10deg) rotateX(6deg) rotateZ(1deg);
    animation: float 6s ease-in-out infinite;
    max-width: 380px;
    margin-inline: auto;
  }

  @keyframes float {
    0%,
    100% {
      transform: rotateY(-10deg) rotateX(6deg) rotateZ(1deg) translateY(0);
    }
    50% {
      transform: rotateY(-10deg) rotateX(6deg) rotateZ(1deg) translateY(-14px);
    }
  }

  .mockup__topbar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .mockup__topbar span:not(.mockup__topbar-label) {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: rgba(11, 23, 48, 0.15);
  }

  .mockup__topbar-label {
    margin-left: 0.5rem;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--gray);
  }

  .mockup__stats {
    display: flex;
    gap: 0.75rem;
    margin-top: 1.1rem;
  }

  .mockup__stat {
    flex: 1;
    background: var(--bg);
    border-radius: var(--radius-sm);
    padding: 0.75rem 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .mockup__stat-label {
    font-size: 0.68rem;
    color: var(--gray);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .mockup__stat-value {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.3rem;
    color: var(--blue);
  }

  .mockup__chart {
    margin-top: 1.1rem;
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    height: 70px;
    padding: 0.5rem;
    background: var(--bg);
    border-radius: var(--radius-sm);
  }

  .mockup__chart span {
    flex: 1;
    height: var(--h);
    border-radius: 4px;
    background: var(--brand-gradient);
    transition: height 0.8s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--d);
  }

  .js .hero__visual .mockup__chart span {
    height: 0;
  }

  .js .hero__visual.is-visible .mockup__chart span {
    height: var(--h);
  }

  .mockup__feed {
    margin: 1.1rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .mockup__feed li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--ink);
  }

  .mockup__feed em {
    margin-left: auto;
    font-style: normal;
    font-weight: 500;
    color: var(--gray);
    font-size: 0.7rem;
  }

  .mockup__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--cyan);
    flex-shrink: 0;
  }

  .mockup__dot--gold {
    background: var(--gold);
  }

  .mockup__dot--live {
    animation: dotPulse 1.8s ease-in-out infinite;
  }

  @keyframes dotPulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(43, 184, 217, 0.45);
    }
    50% {
      box-shadow: 0 0 0 6px rgba(43, 184, 217, 0);
    }
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .hero__visual {
      order: -1;
    }

    .mockup {
      max-width: 320px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mockup {
      animation: none;
      transform: none;
    }
  }
</style>
